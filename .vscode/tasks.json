{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install on phone (debug)",
      "type": "shell",
      "command": "gradle installDebug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Build debug APK",
      "type": "shell",
      "command": "gradle assembleDebug",
      "problemMatcher": []
    },
    {
      "label": "Open app on phone",
      "type": "shell",
      "command": "adb shell am start -n com.example.webapp/.MainActivity",
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "gradle clean",
      "problemMatcher": []
    }
  ]
}
